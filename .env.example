# Supabase — get these from your Supabase project dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── .env.server (never .env) ────────────────────────────────────────────────
# Server-only secrets used by local dev scripts. Never prefix with EXPO_PUBLIC_.
# Copy to .env.server and fill in your values:
#
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
#   SUPABASE_JWT_SECRET=your-jwt-secret-here

# ─── Edge Function secrets (set via `supabase secrets set`) ──────────────────
# HAVEN_API_KEY   — API key for second-horizon.com (used by haven-proxy function)
# OPENAI_API_KEY  — OpenAI key (used by ai-companion function)
