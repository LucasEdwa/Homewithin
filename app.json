{
  "expo": {
    "name": "Homewithin",
    "slug": "Homewithin",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/homeIcon_fixed.png",
    "scheme": "homewithin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homewithin.app",
      "buildNumber": "8",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Homewithin uses your location to show LGBTQ+ resources near you.",
        "NSPhotoLibraryUsageDescription": "HomeWithin uses your photo library so you can choose a profile photo. For example, you can select a selfie or any image to use as your avatar. Your photo is only uploaded when you choose it and is not shared with anyone except as your visible profile picture.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "versionCode": 5,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/homeIcon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#0F0D0C"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/homeIcon.png",
          "color": "#5B8DEF",
          "defaultChannel": "chat"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Homewithin uses your location to show LGBTQ+ resources near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e52ce06c-86f3-40ee-9d71-b5b14b0da4ef"
      }
    }
  }
}
